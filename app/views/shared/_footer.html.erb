<footer class="footer">
    <div class="footer_inner">
        <%= link_to root_path, class: "footer_logo", aria: { label: "AFACTS" } do %>
            <%= image_tag "new_logo.png", alt: "AFACTS", class: "footer_logo_img" %>
        <% end %>

        <nav class="footer_nav" aria-label="Навигация в футере">
            <%= link_to "Главная", root_path, class: "footer_link footer_link_home" %>
            <%= link_to "О нас", about_path, class: "footer_link footer_link_about" %>
            <%= link_to "Учебник", tutorials_path, class: "footer_link footer_link_tutorial" %>
            <%= link_to "Статьи", articles_path, class: "footer_link footer_link_articles" %>
            <%= link_to "Коммьюнити", community_index_path, class: "footer_link footer_link_community" %>
        </nav>

        <div class="footer_creators">
            <p>Наранзаяа Оюунбаатар</p>
            <p>Мария Скрипнюк</p>
            <p>Дарья Якутина</p>
        </div>

        <%= link_to "https://t.me/a_ffacts",
            class: "footer_telegram_link",
            target: "_blank",
            rel: "noopener",
            aria: { label: "Telegram" } do %>
            <span class="footer_telegram_icon"></span>
        <% end %>
    </div>
</footer>
