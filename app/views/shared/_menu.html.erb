<%
  menu_logo_color_class = if current_page?(root_path) || current_page?(about_path)
    "menu_logo_home"
  elsif controller_name == "articles"
    "menu_logo_articles"
  elsif controller_name == "tutorials"
    "menu_logo_tutorial"
  elsif controller_name == "community"
    "menu_logo_community"
  end
%>

<nav class="menu">
    <%= link_to root_path, class: ["menu_logo", menu_logo_color_class].compact.join(" "), aria: { label: "AFACTS" } do %>
    <%= render "shared/logo_updated" %>
    <% end %>
    <div class="W_MainSection">
        <%= link_to "Главная", root_path,
        id: "menu_home",
        class: "menu_link menu_link_home #{'menu_link_home_active' if current_page?(root_path)}" %>
        <%= link_to "О нас", about_path,
        id: "menu_about",
        class: "menu_link menu_link_about #{'menu_link_about_active' if current_page?(about_path)}" %>

        <% if user_signed_in? && current_user.respond_to?(:admin?) && current_user.admin? %>
        <%= link_to "Учебник", admin_tutorials_path,
        id: "menu_tutorial",
        class: "menu_link menu_link_tutorial #{'menu_link_tutorial_active' if controller_name == 'tutorials'}" %>

        <%= link_to "Статьи", admin_articles_path,
        id: "menu_articles",
        class: "menu_link menu_link_articles #{'menu_link_articles_active' if controller_name == 'articles'}" %>

        <%= link_to "Коммьюнити", admin_community_path,
        id: "menu_community",
        class: "menu_link menu_link_community #{'menu_link_community_active' if controller_name == 'community'}" %>
        <% else %>
        <%= link_to "Учебник", tutorials_path,
        id: "menu_tutorial",
        class: "menu_link menu_link_tutorial #{'menu_link_tutorial_active' if controller_name == 'tutorials'}" %>

        <%= link_to "Статьи", articles_path,
        id: "menu_articles",
        class: "menu_link menu_link_articles #{'menu_link_articles_active' if controller_name == 'articles'}" %>

        <%= link_to "Коммьюнити", community_index_path,
        id: "menu_community",
        class: "menu_link menu_link_community #{'menu_link_community_active' if controller_name == 'community'}" %>
        <% end %>
    </div>
    <div class="menu_search_user">
        <div class="menu_search">
            <%= form_with url: articles_path, method: :get, local: true, class: "menu_search_form" do %>
            <%= text_field_tag :query,
        params[:query],
        placeholder: "Дюна...",
        class: "menu_search_input" %>
            <% end %>
            <span class="menu_search_icon">
                <%= image_tag "search_icon.png", alt: "", class: "menu_search_icon_img" %>
                <%= image_tag "mobile_menu_search.svg", alt: "", class: "menu_search_icon_img_mobile" %>
            </span>
        </div>
        <div id="menu_user">
            <% if user_signed_in? %>
            <%= link_to profile_path,
                class: "menu-profile-link",
                title: "Профиль" do %>

            <%= image_tag "profile_icon.png", alt: "Профиль", class: "menu-profile-icon" %>
            <%= image_tag "mobile_menu_profile.svg", alt: "Профиль", class: "menu-profile-icon-mobile" %>

            <% end %>
            <% else %>

            <%= link_to new_session_path(:user),
                class: "menu-profile-link",
                title: "Войти" do %>

            <%= image_tag "profile_icon.png", alt: "Войти", class: "menu-profile-icon" %>
            <%= image_tag "mobile_menu_profile.svg", alt: "Войти", class: "menu-profile-icon-mobile" %>

            <% end %>
            <% end %>
        </div>
    </div>

    <button class="mobile_menu_burger" type="button" aria-label="Открыть меню" data-mobile-menu-toggle>
        <%= image_tag "mobile_menu_burger.svg", alt: "", class: "mobile_menu_burger_icon" %>
    </button>

</nav>
