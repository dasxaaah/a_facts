<div class="lesson_page">
    <% if @lesson.cover_image.present? %>
    <div class="lesson_cover">
        <%= image_tag @lesson.cover_image.url, alt: @lesson.title %>
    </div>
    <% end %>

    <div class="lesson_header">
        <div class="lesson_header_main">
            <h1 class="lesson_title"><%= @lesson.title %></h1>

            <div class="lesson_header_actions">
                <div class="lesson_header_indicator">
                    < <%= @lesson.module_name %>> Урок <%= @lesson.lesson_number %>
                </div>

                <button class="lesson_favorite_button" type="button">
                    В избранное
                </button>
            </div>
        </div>
    </div>

    <div class="lesson_layout">
        <aside class="lesson_sidebar">
            <div class="lesson_sidebar_title">Содержание</div>

            <nav class="lesson_toc">
                <a href="#section_1" class="lesson_toc_link">Чем VFX отличается от спецэффектов (SFX)?
                </a>
                <a href="#section_2" class="lesson_toc_link">Из чего состоят VFX? 3 ключевых кита:</a>
                <a href="#section_3" class="lesson_toc_link">Где применяются VFX сегодня?</a>
            </nav>
        </aside>

        <main class="lesson_content">
            <%= @lesson.body.to_s.html_safe %>
            <div class="lesson_card_action">
                <%= link_to "следующий урок", lesson_path(1), class: "lesson_card_button next_lesson_button" %> </div>
        </main>
    </div>
</div>