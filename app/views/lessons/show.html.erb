<div class="lesson_page">
    <% if @lesson.cover_image.present? %>
    <div class="lesson_cover">
        <%= image_tag @lesson.cover_image.url, alt: @lesson.title %>
    </div>
    <% end %>

    <div class="lesson_header">
        <div class="lesson_header_main">
            <h1 class="lesson_title"><%= @lesson.title %></h1>

            <div class="lesson_header_actions">
                <div class="lesson_header_indicator">
                    <% if @previous_module_lesson %>
                    <%= link_to "<", lesson_path(@previous_module_lesson), class: "lesson_header_module_nav", aria: { label: "Предыдущий модуль" } %>
                    <% else %>
                    <span class="lesson_header_module_nav lesson_header_module_nav_disabled">&lt;</span>
                    <% end %>

                    <span><%= @lesson.module_name %></span>

                    <% if @next_module_lesson %>
                    <%= link_to ">", lesson_path(@next_module_lesson), class: "lesson_header_module_nav", aria: { label: "Следующий модуль" } %>
                    <% else %>
                    <span class="lesson_header_module_nav lesson_header_module_nav_disabled">&gt;</span>
                    <% end %>

                    <span>Урок <%= @lesson.lesson_number %></span>
                </div>

                <% is_favourite = FavouriteLesson.exists?(user_id: current_user.id, lesson_id: @lesson.id) %>

                <%= button_to is_favourite ? "Добавлено" : "В избранное",
                    toggle_favourite_lesson_path(@lesson),
                    method: :post,
                    class: "lesson_favorite_button #{'is_favourite' if is_favourite}" %>
            </div>
        </div>
    </div>

    <div class="lesson_layout">
        <aside class="lesson_sidebar">
            <div class="lesson_sidebar_title">Содержание</div>

            <nav class="lesson_toc">
                <a href="#section_1" class="lesson_toc_link">Чем VFX отличается от спецэффектов (SFX)?
                </a>
                <a href="#section_2" class="lesson_toc_link">Из чего состоят VFX? 3 ключевых кита:</a>
                <a href="#section_3" class="lesson_toc_link">Где применяются VFX сегодня?</a>
            </nav>
        </aside>

        <main class="lesson_content">
            <% video_embed_url = rutube_embed_url(@lesson.video_url) %>
            <% if video_embed_url %>
            <div class="lesson_video">
                <iframe src="<%= video_embed_url %>" title="<%= @lesson.title %>" frameborder="0" allow="clipboard-write; autoplay; fullscreen" webkitallowfullscreen mozallowfullscreen allowfullscreen></iframe>
            </div>
            <% else %>
            <%= grouped_lesson_body(@lesson.body) %>
            <% end %>
            <div class="lesson_card_action">
                <% if @next_lesson %>
                <%= link_to "следующий урок", lesson_path(@next_lesson), class: "lesson_card_button next_lesson_button" %>
                <% end %>
            </div>
        </main>
    </div>
</div>
