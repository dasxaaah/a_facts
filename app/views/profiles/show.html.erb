<div class="profile_page">
    <aside class="profile_sidebar">
        <div class="profile_identity">
            <div class="profile_avatar">
                <%= image_tag "profile_icon.png", alt: "", class: "profile_avatar_icon" %>
            </div>

            <p class="profile_name"><%= (@user.name.presence || @user.email.split("@").first).upcase %></p>
            <p class="profile_nickname">@<%= @user.nickname.presence || @user.email.split("@").first %></p>
        </div>

        <div class="profile_tabs">
            <%= link_to "Работы",
                profile_path(tab: "works"),
                class: "profile_tab #{'profile_tab_active' if @active_tab == 'works'}" %>

            <%= link_to "Избранное",
                profile_path(tab: "favorites"),
                class: "profile_tab #{'profile_tab_active' if @active_tab == 'favorites'}" %>

            <%= link_to "Настройки",
                profile_path(tab: "settings"),
                class: "profile_tab #{'profile_tab_active' if @active_tab == 'settings'}" %>
        </div>

        <% if @active_tab == "works" %>
            <button class="profile_drafts_button <%= 'profile_drafts_button_active' if @show_drafts %>" type="button" data-profile-show-drafts>
                Черновики
            </button>
        <% end %>
    </aside>

    <main class="profile_content">

    <% if @active_tab == "works" %>
    <section class="profile_section profile_section_with_bottom_space">
        <div class="profile_section_header">
            <h1 class="profile_grid_title" data-profile-grid-title><%= @show_drafts ? "Черновики" : "Работы" %></h1>

            <button class="profile_add_work_button" type="button" data-open-profile-work-modal>
                Добавить работу
            </button>
        </div>

        <div class="profile_drafts_folder <%= 'profile_drafts_folder_visible' if @show_drafts %>" data-profile-drafts-panel>
            <div class="profile_works_grid profile_drafts_grid" data-profile-drafts-grid>
                <% if @draft_projects.any? %>
                    <% @draft_projects.each do |project| %>
                    <article class="profile_work_card">
                        <div class="profile_work_image">
                            <% if project.media.attached? && project.media.content_type.start_with?("image/") %>
                                <%= image_tag project.media, alt: project.title %>
                            <% elsif project.media.attached? && project.media.content_type.start_with?("video/") %>
                                <%= video_tag url_for(project.media), controls: true, muted: true %>
                            <% else %>
                                <div class="profile_work_text_preview">Текст</div>
                            <% end %>
                        </div>

                        <h3 class="profile_work_title"><%= project.title %></h3>
                    </article>
                    <% end %>
                <% else %>
                    <p class="profile_empty" data-profile-drafts-empty>Пока нет черновиков</p>
                <% end %>
            </div>
        </div>

        <div class="profile_works_grid <%= 'profile_published_grid_hidden' if @show_drafts %>" data-profile-works-grid data-profile-published-panel>
            <% @published_projects.each do |project| %>
            <article class="profile_work_card">
                <div class="profile_work_image">
                    <% if project.media.attached? && project.media.content_type.start_with?("image/") %>
                        <%= image_tag project.media, alt: project.title %>
                    <% elsif project.media.attached? && project.media.content_type.start_with?("video/") %>
                        <%= video_tag url_for(project.media), controls: true, muted: true %>
                    <% else %>
                        <div class="profile_work_text_preview">Текст</div>
                    <% end %>
                </div>

                <h3 class="profile_work_title"><%= project.title %></h3>
            </article>
            <% end %>

            <article class="profile_work_card">
                <div class="profile_work_image">
                    <%= image_tag "work_1.jpg", alt: "Работа 1" %>
                </div>

                <h3 class="profile_work_title">MIrage</h3>
            </article>

            <article class="profile_work_card">
                <div class="profile_work_image">
                    <%= image_tag "work_2.jpg", alt: "Работа 2" %>
                </div>

                <h3 class="profile_work_title">DEAD HEAD // CGI SHORT</h3>
            </article>

            <article class="profile_work_card">
                <div class="profile_work_image">
                    <%= image_tag "work_3.jpg", alt: "Работа 3" %>
                </div>

                <h3 class="profile_work_title">Obelisco</h3>
            </article>
        </div>
    </section>

    <div class="profile_work_modal" data-profile-work-modal>
        <%= form_with model: @project, url: projects_path, local: true, html: { multipart: true, class: "profile_work_form", data: { profile_work_form: true } } do |f| %>
        <%= f.hidden_field :status, value: "published", data: { profile_work_status_input: true } %>
        <%= f.hidden_field :kind, value: "text", data: { profile_work_kind_input: true } %>

        <div class="profile_work_modal_window">
            <div class="profile_work_modal_header">
                <button class="profile_work_modal_back" type="button" aria-label="Назад" data-close-profile-work-modal></button>

                <h2 class="profile_work_modal_title">Новый проект</h2>

                <div class="profile_work_modal_actions" data-profile-work-actions>
                    <button class="profile_work_draft_button" type="button" data-profile-work-save-draft>Сохранить в черновик</button>
                    <button class="profile_work_publish_button" type="button" data-profile-work-publish>Опубликовать</button>
                </div>
            </div>

            <div class="profile_work_start" data-profile-work-start>
                <div class="profile_work_start_inner">
                    <p class="profile_work_start_text">Начните создавать новый проект</p>
                    <p class="profile_work_start_size">ширина 1600 px</p>

                    <div class="profile_work_type_buttons">
                        <button class="profile_work_type_button" type="button" data-profile-work-type="photo">
                            <%= image_tag "image_icon.png", alt: "", class: "profile_work_type_icon" %>
                            <span>Фото</span>
                        </button>

                        <button class="profile_work_type_button" type="button" data-profile-work-type="video">
                            <%= image_tag "file_icon.png", alt: "", class: "profile_work_type_icon" %>
                            <span>Видео</span>
                        </button>

                        <button class="profile_work_type_button" type="button" data-profile-work-type="text">
                            <%= image_tag "comment_icon.png", alt: "", class: "profile_work_type_icon" %>
                            <span>Текст</span>
                        </button>
                    </div>

                    <%= file_field_tag "project[media]",
                        accept: "image/*",
                        id: "project_photo_media",
                        class: "profile_work_file_input",
                        data: { profile_work_photo_input: true } %>
                    <%= file_field_tag "project[media]",
                        accept: "video/*",
                        id: "project_video_media",
                        class: "profile_work_file_input",
                        data: { profile_work_video_input: true } %>
                </div>
            </div>

            <div class="profile_work_editor" data-profile-work-editor>
                <div class="profile_work_editor_main">
                    <div class="profile_work_preview" data-profile-work-preview>
                        <p class="profile_work_preview_empty">Выберите файл или начните с текста</p>
                    </div>

                    <%= f.text_area :description,
                        class: "profile_work_description",
                        placeholder: "Описание проекта",
                        data: { profile_work_description: true } %>
                </div>

                <aside class="profile_work_editor_panel">
                    <label class="profile_work_field">
                        <span>Название проекта</span>
                        <%= f.text_field :title,
                            class: "profile_work_title_input",
                            placeholder: "Введите название",
                            data: { profile_work_title_input: true } %>
                    </label>

                    <p class="profile_work_panel_title">Добавить</p>

                    <div class="profile_work_panel_buttons">
                        <button class="profile_work_type_button profile_work_type_button_small" type="button" data-profile-work-type="photo">
                            <%= image_tag "image_icon.png", alt: "", class: "profile_work_type_icon" %>
                            <span>Фото</span>
                        </button>

                        <button class="profile_work_type_button profile_work_type_button_small" type="button" data-profile-work-type="video">
                            <%= image_tag "file_icon.png", alt: "", class: "profile_work_type_icon" %>
                            <span>Видео</span>
                        </button>

                        <button class="profile_work_type_button profile_work_type_button_small" type="button" data-profile-work-type="text">
                            <%= image_tag "comment_icon.png", alt: "", class: "profile_work_type_icon" %>
                            <span>Текст</span>
                        </button>
                    </div>

                    <p class="profile_work_panel_title">Настройки</p>

                    <div class="profile_work_setting">
                        <span>Фон</span>
                        <div class="profile_work_color_control">
                            <span data-profile-work-color-code>#000000</span>
                            <label class="profile_work_color_button" aria-label="Выбрать цвет">
                                <input type="color" value="#000000" data-profile-work-color-input>
                            </label>
                        </div>
                    </div>

                    <div class="profile_work_setting profile_work_setting_column">
                        <div class="profile_work_setting_row">
                            <span>Отступы</span>
                            <span data-profile-work-line-height-value>1.4</span>
                        </div>

                        <input class="profile_work_range" type="range" min="1" max="2.5" step="0.1" value="1.4" data-profile-work-line-height>
                    </div>
                </aside>
            </div>
        </div>
        <% end %>
    </div>

    <% elsif @active_tab == "favorites" %>
    <section class="profile_section profile_section_with_bottom_space">
        <div class="profile_section_header">
            <h1 class="profile_grid_title">Избранное</h1>
        </div>

        <div class="profile_board_items_grid profile_favorites_items_grid">
            <% @favourite_articles.each do |article| %>
                <%= link_to article_path(article), class: "profile_board_item" do %>
                    <span class="profile_board_item_badge profile_board_item_badge_article">Статья</span>

                    <div class="profile_board_item_image">
                        <% if article.cover_image.present? %>
                            <%= image_tag article.cover_image.url, alt: article.title %>
                        <% else %>
                            <%= image_tag "contest_preview_1.jpg", alt: article.title %>
                        <% end %>
                    </div>

                    <h3 class="profile_board_item_title"><%= article.title %></h3>
                <% end %>
            <% end %>

            <% @favourite_lessons.each do |lesson| %>
                <%= link_to lesson_path(lesson), class: "profile_board_item" do %>
                    <span class="profile_board_item_badge profile_board_item_badge_lesson">Урок</span>

                    <div class="profile_board_item_image">
                        <% if lesson.cover_image.present? %>
                            <%= image_tag lesson.cover_image.url, alt: lesson.title %>
                        <% else %>
                            <%= image_tag "meetup_1.jpg", alt: lesson.title %>
                        <% end %>
                    </div>

                    <h3 class="profile_board_item_title"><%= lesson.title %></h3>
                <% end %>
            <% end %>

            <% if @favourite_articles.empty? && @favourite_lessons.empty? %>
                <p class="profile_favorites_empty">Вы пока не добавили статьи или уроки в избранное.</p>
            <% end %>
        </div>

        <div class="profile_section_header profile_boards_header">
            <h2 class="profile_grid_title">Доски</h2>

            <button class="profile_add_work_button" type="button">
                Создать
            </button>
        </div>

        <div class="profile_boards_grid">
            <button class="profile_board_card" type="button" data-open-profile-board data-profile-board-name="Учеба">
                <div class="profile_board_collage">
                    <%= image_tag "film01.jpg", alt: "" %>
                    <%= image_tag "work_1.jpg", alt: "" %>
                    <%= image_tag "work_2.jpg", alt: "" %>
                    <%= image_tag "contest_preview_1.jpg", alt: "" %>
                </div>

                <h3 class="profile_board_title">Учеба</h3>
            </button>

            <button class="profile_board_card" type="button" data-open-profile-board data-profile-board-name="Разборы сцен">
                <div class="profile_board_collage">
                    <%= image_tag "work_2.jpg", alt: "" %>
                    <%= image_tag "contest_preview_2.jpg", alt: "" %>
                    <%= image_tag "work_3.jpg", alt: "" %>
                    <%= image_tag "home_collage_center.jpg", alt: "" %>
                </div>

                <h3 class="profile_board_title">Разборы сцен</h3>
            </button>

            <button class="profile_board_card" type="button" data-open-profile-board data-profile-board-name="Техника">
                <div class="profile_board_collage">
                    <%= image_tag "work_3.jpg", alt: "" %>
                    <%= image_tag "contest_preview_3.jpg", alt: "" %>
                    <%= image_tag "slider_1.jpg", alt: "" %>
                    <%= image_tag "home_icons_banner.jpg", alt: "" %>
                </div>

                <h3 class="profile_board_title">Техника</h3>
            </button>
        </div>
    </section>

    <div class="profile_board_view" data-profile-board-view>
        <div class="profile_board_view_window">
            <div class="profile_board_view_header">
                <div>
                    <button class="profile_work_modal_back" type="button" aria-label="Назад" data-close-profile-board></button>
                    <h2 class="profile_board_view_title" data-profile-board-view-title>Техника</h2>
                    <p class="profile_board_view_count"><span data-profile-board-count>4</span> добавления</p>
                </div>

                <label class="profile_board_filter">
                    <span class="profile_board_filter_label">Фильтр</span>
                    <select data-profile-board-filter>
                        <option value="all">Все</option>
                        <option value="article">Статья</option>
                        <option value="work">Работа</option>
                        <option value="lesson">Урок</option>
                    </select>
                </label>
            </div>

            <div class="profile_board_items_grid" data-profile-board-items>
                <% @favourite_articles.each do |article| %>
                    <%= link_to article_path(article), class: "profile_board_item", data: { profile_board_item: true, profile_board_type: "article" } do %>
                        <span class="profile_board_item_badge profile_board_item_badge_article">Статья</span>

                        <div class="profile_board_item_image">
                            <% if article.cover_image.present? %>
                                <%= image_tag article.cover_image.url, alt: article.title %>
                            <% else %>
                                <%= image_tag "contest_preview_1.jpg", alt: article.title %>
                            <% end %>
                        </div>

                        <h3 class="profile_board_item_title"><%= article.title %></h3>
                    <% end %>
                <% end %>

                <% @published_projects.each do |project| %>
                    <article class="profile_board_item" data-profile-board-item data-profile-board-type="work">
                        <span class="profile_board_item_badge profile_board_item_badge_work">Работа</span>

                        <div class="profile_board_item_image">
                            <% if project.media.attached? && project.media.content_type.start_with?("image/") %>
                                <%= image_tag project.media, alt: project.title %>
                            <% elsif project.media.attached? && project.media.content_type.start_with?("video/") %>
                                <%= video_tag url_for(project.media), muted: true %>
                            <% else %>
                                <%= image_tag "work_2.jpg", alt: project.title %>
                            <% end %>
                        </div>

                        <h3 class="profile_board_item_title"><%= project.title %></h3>
                    </article>
                <% end %>

                <% @favourite_lessons.each do |lesson| %>
                    <%= link_to lesson_path(lesson), class: "profile_board_item", data: { profile_board_item: true, profile_board_type: "lesson" } do %>
                        <span class="profile_board_item_badge profile_board_item_badge_lesson">Урок</span>

                        <div class="profile_board_item_image">
                            <% if lesson.cover_image.present? %>
                                <%= image_tag lesson.cover_image.url, alt: lesson.title %>
                            <% else %>
                                <%= image_tag "meetup_1.jpg", alt: lesson.title %>
                            <% end %>
                        </div>

                        <h3 class="profile_board_item_title"><%= lesson.title %></h3>
                    <% end %>
                <% end %>

                <% if @favourite_articles.empty? && @published_projects.empty? && @favourite_lessons.empty? %>
                    <article class="profile_board_item" data-profile-board-item data-profile-board-type="article">
                        <span class="profile_board_item_badge profile_board_item_badge_article">Статья</span>
                        <div class="profile_board_item_image">
                            <%= image_tag "contest_preview_1.jpg", alt: "" %>
                        </div>
                        <h3 class="profile_board_item_title">Как работает 3D-сканирование</h3>
                    </article>

                    <article class="profile_board_item" data-profile-board-item data-profile-board-type="work">
                        <span class="profile_board_item_badge profile_board_item_badge_work">Работа</span>
                        <div class="profile_board_item_image">
                            <%= image_tag "work_2.jpg", alt: "" %>
                        </div>
                        <h3 class="profile_board_item_title">DEAD HEAD // CGI SHORT</h3>
                    </article>

                    <article class="profile_board_item" data-profile-board-item data-profile-board-type="article">
                        <span class="profile_board_item_badge profile_board_item_badge_article">Статья</span>
                        <div class="profile_board_item_image">
                            <%= image_tag "work_1.jpg", alt: "" %>
                        </div>
                        <h3 class="profile_board_item_title">За кулисами: сцены из «Безумного Макса»</h3>
                    </article>

                    <article class="profile_board_item" data-profile-board-item data-profile-board-type="lesson">
                        <span class="profile_board_item_badge profile_board_item_badge_lesson">Урок</span>
                        <div class="profile_board_item_image">
                            <%= image_tag "meetup_1.jpg", alt: "" %>
                        </div>
                        <h3 class="profile_board_item_title">On-set VFX</h3>
                    </article>
                <% end %>
            </div>
        </div>
    </div>
    <% elsif @active_tab == "settings" %>
    <section class="profile_section">
        <div class="profile_settings_panel">
            <section class="profile_settings_group">
                <h2 class="profile_settings_group_title">Детали аккаунта</h2>

                <%= form_with model: @user, url: profile_path, method: :patch, local: true, class: "profile_settings_account_form", data: { profile_settings_form: true } do |f| %>
                    <div class="profile_settings_row profile_settings_form_row">
                        <label class="profile_settings_field">
                            <span>Имя:</span>
                            <%= f.text_field :name,
                                value: @user.name.presence || @user.email.split("@").first.capitalize,
                                readonly: true,
                                data: { profile_settings_input: true } %>
                        </label>

                        <button class="profile_settings_edit_button" type="button" aria-label="Редактировать имя" data-profile-settings-edit></button>
                    </div>

                    <div class="profile_settings_row profile_settings_form_row">
                        <label class="profile_settings_field">
                            <span>Ник:</span>
                            <%= f.text_field :nickname,
                                value: @user.nickname.presence || @user.email.split("@").first,
                                readonly: true,
                                data: { profile_settings_input: true } %>
                        </label>

                        <button class="profile_settings_edit_button" type="button" aria-label="Редактировать ник" data-profile-settings-edit></button>
                    </div>

                    <div class="profile_settings_row profile_settings_form_row">
                        <label class="profile_settings_field">
                            <span>Почта:</span>
                            <%= f.email_field :email,
                                readonly: true,
                                data: { profile_settings_input: true } %>
                        </label>

                        <button class="profile_settings_edit_button" type="button" aria-label="Редактировать почту" data-profile-settings-edit></button>
                    </div>

                    <div class="profile_settings_row profile_settings_form_row profile_settings_password_row">
                        <div class="profile_settings_field profile_settings_password_field">
                            <span>Пароль:</span>

                            <div class="profile_settings_password_preview" data-profile-settings-password-preview>**************</div>

                            <div class="profile_settings_password_inputs" data-profile-settings-password-inputs>
                                <%= f.password_field :password,
                                    placeholder: "Новый пароль",
                                    autocomplete: "new-password",
                                    disabled: true,
                                    data: { profile_settings_input: true } %>
                                <%= f.password_field :password_confirmation,
                                    placeholder: "Повторите пароль",
                                    autocomplete: "new-password",
                                    disabled: true,
                                    data: { profile_settings_input: true } %>
                            </div>
                        </div>

                        <button class="profile_settings_edit_button" type="button" aria-label="Редактировать пароль" data-profile-settings-edit></button>
                    </div>
                <% end %>
            </section>

            <section class="profile_settings_group">
                <h2 class="profile_settings_group_title">Тема оформления</h2>

                <label class="profile_settings_row profile_settings_choice">
                    <span>Темная</span>
                    <input type="radio" name="profile_theme" checked>
                    <span class="profile_settings_radio"></span>
                </label>

                <label class="profile_settings_row profile_settings_choice">
                    <span>Светлая</span>
                    <input type="radio" name="profile_theme">
                    <span class="profile_settings_radio"></span>
                </label>
            </section>

            <section class="profile_settings_group">
                <h2 class="profile_settings_group_title">Геймификация</h2>

                <label class="profile_settings_row profile_settings_choice">
                    <span>Показывать мои звания и бейджи</span>
                    <input type="checkbox" checked>
                    <span class="profile_settings_switch"></span>
                </label>

                <label class="profile_settings_row profile_settings_choice">
                    <span>Показывать прогресс в учебнике публично</span>
                    <input type="checkbox" checked>
                    <span class="profile_settings_switch"></span>
                </label>

                <label class="profile_settings_row profile_settings_choice">
                    <span>Участие в рейтингах</span>
                    <input type="checkbox">
                    <span class="profile_settings_switch"></span>
                </label>
            </section>

            <section class="profile_settings_group">
                <h2 class="profile_settings_group_title">Подписка</h2>

                <div class="profile_settings_row">
                    <span>Текущий тариф: Бесплатный/Premium/Pro</span>
                </div>

                <div class="profile_settings_row">
                    <span>Дата окончания: 22.03.26</span>
                </div>

                <div class="profile_settings_row">
                    <span>Способы оплаты: MIR*1345</span>
                </div>

                <div class="profile_settings_row profile_settings_subscription_row">
                    <span>Управление подпиской</span>
                    <button class="profile_settings_pay_button" type="button">Оплатить 199₽</button>
                </div>
            </section>

            <% if @user.errors.any? %>
                <div class="profile_settings_errors">
                    <% @user.errors.full_messages.each do |message| %>
                        <p><%= message %></p>
                    <% end %>
                </div>
            <% end %>

            <%= button_to "Выйти",
                destroy_user_session_path,
                method: :delete,
                class: "profile_logout_button" %>
        </div>
    </section>
    <% end %>
    </main>
</div>
