<!-- Фильтры -->
<div class="articles_filter">
    <%= link_to "Все статьи",
      articles_path,
      class: "articles_filter_item #{'active' unless @selected_category || @selected_filters.any?}" %>

    <%
      filter_options = Article::SUBCATEGORIES_BY_CATEGORY
      category_labels = Article::CATEGORY_LABELS
    %>

    <% @categories.each do |category| %>
    <% if filter_options[category] %>
    <% selected_category_filters = @selected_filters & filter_options[category] %>
    <% other_selected_filters = @selected_filters - filter_options[category] %>
    <div class="articles_filter_dropdown" data-article-filter>
        <button class="articles_filter_item articles_filter_button <%= 'active' if @selected_category == category || selected_category_filters.any? %>" type="button" data-article-filter-toggle>
            <span><%= category_labels.fetch(category, category) %></span>
            <span class="articles_filter_arrow"></span>
            <% if selected_category_filters.any? %>
            <span class="articles_filter_count">+<%= selected_category_filters.size %></span>
            <% end %>
        </button>

        <form class="articles_filter_menu" action="<%= articles_path %>" method="get">
            <% other_selected_filters.each do |filter| %>
            <input type="hidden" name="filters[]" value="<%= filter %>">
            <% end %>

            <% filter_options[category].each do |option| %>
            <label class="articles_filter_option">
                <span><%= option %></span>
                <input type="checkbox" name="filters[]" value="<%= option %>" <%= "checked" if selected_category_filters.include?(option) %>>
            </label>
            <% end %>

            <button class="articles_filter_apply" type="submit">Применить</button>
        </form>
    </div>
    <% else %>
    <%= link_to category,
        articles_path(category: category),
        class: "articles_filter_item #{'active' if @selected_category == category}" %>
    <% end %>
    <% end %>

    <%= link_to "Очистить", articles_path, class: "articles_filter_item articles_filter_clear" %>
</div>

<!-- Сетка карточек -->
<div class="articles_grid" id="articles_grid">
    <% counter = 0 %>

    <% @articles.each do |article| %>

    <div class="article_card">
        <div class="article_card_meta">
            <span class="article_card_tag">
                <% if (icon = category_icon(article.category)) %>
                <%= image_tag icon, class: "category_icon", alt: "" %>
                <% end %>
                <%= article.category %>
            </span>

            <span class="article_card_time">
                <%= article.reading_minutes %> мин
            </span>
        </div>

        <% if article.cover_image.present? %>
        <%= link_to article_path(article), class: "article_card_image_link" do %>
        <div class="article_card_image">
            <%= image_tag article.cover_image.url, alt: article.title %>
        </div>
        <% end %>
        <% end %>

        <h2 class="article_card_title">
            <%= link_to article.title,
                    article_path(article),
                    class: "article_card_title_link" %>
        </h2>
    </div>

    <% counter += 1 %>

    <% if counter == 2 %>
    <div class="push_card push_card--w2"></div>
    <% elsif counter == 5 %>
    <div class="push_card push_card--h2"></div>
    <% counter = 0 %>
    <% end %>

    <% end %>
</div>
